# Ghost Guardian Environment Template
# Copy this file to .env and provide your production credentials.

# ----------------------------------------------------
# Client Configuration (Bundled in frontend)
# ----------------------------------------------------
VITE_GHOST_GUARDIAN_RUNTIME=demo
# Leave empty for Vercel (relative URLs route to /api/ serverless functions).
# Set to http://localhost:3001 for local development with the Node.js server.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_STRIPE_BETA_LINK=https://buy.stripe.com/YOUR_BETA_LINK

# ----------------------------------------------------
# Vercel Serverless Functions (Environment Variables)
# Set these in Vercel Dashboard → Settings → Environment Variables.
# These are SERVER-ONLY — no VITE_ prefix, never shipped to the browser.
# ----------------------------------------------------
OPENAI_API_KEY=
YOUTUBE_API_KEY=

# Supabase server-side access (token storage for YouTube OAuth).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth for direct YouTube reply publishing (scope: youtube.force-ssl).
# Obtain from Google Cloud Console → APIs & Services → Credentials (Web app).
# The redirect URI must exactly match one registered on the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/youtube/oauth-callback
# Where users return after connecting (your deployed app origin).
APP_URL=https://your-app.vercel.app

# ----------------------------------------------------
# Server Configuration (Local Development Only)
# The Node.js server in /server/ is NOT deployed to Vercel.
# ----------------------------------------------------
PORT=3001
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
DATABASE_URL=file:./ghost_guardian.sqlite
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# YouTube Data API v3 & OAuth 2.0
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/integrations/youtube/callback

# LLM Inference (Gemini / Anthropic / OpenAI)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro
LLM_API_KEY=
